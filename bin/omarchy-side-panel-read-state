#!/usr/bin/env python3
"""Read a bounded Side Panel state file without following its final symlink."""

from __future__ import annotations

import errno
import os
import stat
import sys


MISSING = 1
TOO_LARGE = 2
UNSAFE = 3


def read_state(path: str, maximum: int) -> bytes:
    flags = os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC
    if not hasattr(os, "O_NOFOLLOW"):
        raise OSError(errno.ENOTSUP, "O_NOFOLLOW is unavailable")
    descriptor = os.open(path, flags | os.O_NOFOLLOW)
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise ValueError("state file is not a regular file")
        if metadata.st_size > maximum:
            raise OverflowError("state file exceeds the size limit")

        chunks: list[bytes] = []
        remaining = maximum + 1
        while remaining > 0:
            chunk = os.read(descriptor, remaining)
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        content = b"".join(chunks)
        if len(content) > maximum:
            raise OverflowError("state file exceeds the size limit")
        return content
    finally:
        os.close(descriptor)


def main() -> int:
    if len(sys.argv) != 3:
        return MISSING
    try:
        maximum = int(sys.argv[2])
        if maximum < 1:
            return MISSING
        sys.stdout.buffer.write(read_state(sys.argv[1], maximum))
        return 0
    except OverflowError:
        return TOO_LARGE
    except ValueError:
        return UNSAFE
    except OSError as error:
        if error.errno in (errno.ELOOP, errno.ENXIO, errno.ENOTSUP):
            return UNSAFE
        return MISSING


if __name__ == "__main__":
    raise SystemExit(main())
