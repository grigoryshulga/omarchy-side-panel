#!/usr/bin/env python3
"""Run a Side Panel helper with bounded streams and a process-group deadline."""

from __future__ import annotations

import argparse
import os
import selectors
import signal
import subprocess
import sys
import time


TIMEOUT = 120
OUTPUT_LIMIT = 121
RUN_ERROR = 122
READ_CHUNK_BYTES = 64 * 1024


def terminate(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    try:
        process.wait(timeout=0.5)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()


def run(command: list[str], maximum: int, timeout: float) -> tuple[int, bytes, bytes]:
    process = subprocess.Popen(
        command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        start_new_session=True,
    )
    assert process.stdout is not None and process.stderr is not None
    streams = selectors.DefaultSelector()
    streams.register(process.stdout, selectors.EVENT_READ, "stdout")
    streams.register(process.stderr, selectors.EVENT_READ, "stderr")
    output = {"stdout": bytearray(), "stderr": bytearray()}
    deadline = time.monotonic() + timeout
    try:
        while streams.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                terminate(process)
                return TIMEOUT, b"", b"helper timed out"
            for key, _ in streams.select(remaining):
                chunk = os.read(key.fileobj.fileno(), READ_CHUNK_BYTES)
                if not chunk:
                    streams.unregister(key.fileobj)
                    continue
                target = output[key.data]
                if len(target) + len(chunk) > maximum:
                    terminate(process)
                    return OUTPUT_LIMIT, b"", b"helper output exceeds the limit"
                target.extend(chunk)
        return process.wait(), bytes(output["stdout"]), bytes(output["stderr"])
    finally:
        streams.close()
        if process.poll() is None:
            terminate(process)


def main() -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--max-bytes", type=int, required=True)
    parser.add_argument("--timeout-seconds", type=float, required=True)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    arguments = parser.parse_args()
    command = arguments.command[1:] if arguments.command[:1] == ["--"] else arguments.command
    if not command or arguments.max_bytes < 1 or arguments.timeout_seconds <= 0:
        return RUN_ERROR
    try:
        code, stdout, stderr = run(command, arguments.max_bytes, arguments.timeout_seconds)
    except OSError as error:
        sys.stderr.buffer.write(str(error).encode("utf-8", "replace")[:arguments.max_bytes])
        return RUN_ERROR
    if stderr:
        sys.stderr.buffer.write(stderr)
    if code == 0:
        sys.stdout.buffer.write(stdout)
    return code


if __name__ == "__main__":
    raise SystemExit(main())
