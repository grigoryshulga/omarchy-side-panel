#!/usr/bin/env bash
set -euo pipefail

source_dir=${1:?source directory is required}
entry_point=${2:?entry point is required}
cache_dir=${3:?cache directory is required}
adapter_dir=${4:?adapter directory is required}

python3 - "$source_dir" "$entry_point" "$cache_dir" "$adapter_dir" <<'PY'
import os
import re
import shutil
import sys
from pathlib import Path

source_dir = Path(sys.argv[1]).resolve()
entry_point = Path(sys.argv[2])
cache_dir = Path(os.path.abspath(sys.argv[3]))
adapter_dir = Path(sys.argv[4]).resolve()
entry_source = (source_dir / entry_point).resolve()

if not entry_source.is_file() or source_dir not in entry_source.parents:
    raise SystemExit("entry point is outside its plugin directory")
if cache_dir.is_symlink():
    raise SystemExit("refusing a symlinked cache directory")
resolved_cache = cache_dir.resolve()
if source_dir == resolved_cache or source_dir in resolved_cache.parents:
    raise SystemExit("cache directory must not point inside the source plugin")

source = entry_source
text = source.read_text(encoding="utf-8")

# Some standard widgets expose a small BarWidget.qml that loads the real
# Panel.qml. The panel is still the portable implementation seam, so discover
# that conventional sibling before giving up on the entry point.
if "KeyboardPanel {" not in text:
    panel_source = source_dir / "Panel.qml"
    if panel_source.is_file():
        source = panel_source.resolve()
        text = source.read_text(encoding="utf-8")
    if "KeyboardPanel {" not in text:
        raise SystemExit("plugin does not use the standard KeyboardPanel host")

# This adapter deliberately supports the documented, standard Omarchy panel
# shape only. A custom PanelWindow has its own Wayland surface and cannot be
# reparented into Drawer without rewriting the source plugin.
text = text.replace("KeyboardPanel {", "DrawerPanelHost { anchors.fill: parent;")

# Standard panels keep their open state in Panel.controller. On close the
# adapted content must leave Drawer too, otherwise it silently vanishes inside
# an open host. The root property is injected only into the generated copy.
if "Panel {" not in text:
    raise SystemExit("standard panel root was not found")
has_close = "function close()" in text
text = text.replace(
    "root.controller.hide()",
    "if (root.drawerHost) root.drawerHost.close(); else root.controller.hide()",
)
panel_root = "Panel {\n  property var drawerHost: null\n  function drawerDeactivate() { root.controller.hide() }"
if "manageIpc:" not in text:
    panel_root += "\n  manageIpc: false"
else:
    text = re.sub(r"manageIpc\s*:\s*(true|false)", "manageIpc: false", text)
if not has_close:
    panel_root += "\n  function close() { if (root.drawerHost) root.drawerHost.close(); else root.controller.hide() }"
text = text.replace("Panel {", panel_root, 1)
# The original bar instance stays live. Replace every textual IPC handler with
# an inert local shim, avoiding duplicate property assignments in source that
# already has its own `enabled:` binding.
text = text.replace("IpcHandler {", "DrawerDisabledIpc {")

if cache_dir.exists():
    shutil.rmtree(cache_dir)
shutil.copytree(source_dir, cache_dir)
relative_source = source.relative_to(source_dir)
(cache_dir / relative_source).write_text(text, encoding="utf-8")
shutil.copy2(adapter_dir / "DrawerPanelHost.qml", cache_dir / "DrawerPanelHost.qml")
shutil.copy2(adapter_dir / "DrawerDisabledIpc.qml", cache_dir / "DrawerDisabledIpc.qml")
print((cache_dir / relative_source).as_uri())
PY
