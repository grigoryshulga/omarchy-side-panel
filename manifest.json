{
  "schemaVersion": 1,
  "id": "gshulga.side-panel",
  "name": "Side Panel",
  "version": "0.1.0",
  "author": "gshulga",
  "description": "A configurable edge side panel that hosts plugin pages and launches standard Omarchy panels.",
  "license": "MIT",
  "kinds": ["bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Side Panel",
    "description": "An edge side panel for secondary plugins",
    "category": "System",
    "defaultSection": "left",
    "allowMultiple": false,
    "defaults": {
      "edge": "left",
      "layoutMode": "overlay",
      "transparentBackground": false
    },
    "schema": [
      {
        "key": "edge",
        "type": "enum",
        "label": "Side panel edge",
        "description": "The screen edge from which the side panel opens.",
        "options": ["left", "right", "top", "bottom"],
        "defaultValue": "left"
      },
      {
        "key": "layoutMode",
        "type": "enum",
        "label": "Side panel layout",
        "description": "Overlay windows or reserve screen space while the side panel is open.",
        "options": ["overlay", "reserve"],
        "defaultValue": "overlay"
      },
      {
        "key": "transparentBackground",
        "type": "boolean",
        "label": "Transparent background",
        "description": "Use a translucent side-panel background.",
        "defaultValue": false
      }
    ]
  }
}
